# JWT — obligatorios. Generá DOS secretos distintos, de 32+ caracteres, con:
#   openssl rand -base64 48
# La app no arranca si faltan, son cortos, parecen valores de ejemplo o son iguales entre sí.
JWT_SECRET=""
JWT_REFRESH_SECRET=""

NODE_ENV="development"

# CORS — orígenes del frontend que pueden usar la API desde un navegador, separados por coma
# y sin "/" final. Vacío = solo mismo origen. No se admite "*".
CORS_ORIGIN="http://localhost:3000"

# Upstash Redis — dejá vacío para usar rate limiting en memoria (solo dev)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Base de datos — PostgreSQL (el schema de Prisma usa el provider "postgresql")
DATABASE_URL="postgresql://user:password@localhost:5432/secureapi?schema=public"
